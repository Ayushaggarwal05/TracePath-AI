# Application Environment (development | staging | production | testing)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TracePath AI Backend"
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracepath_ai
# Sync DB URL for Alembic migrations:
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracepath_ai

# Security & Secret Key
SECRET_KEY=tracepath-development-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub App Configuration (Phase 2)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI Agents Configuration (Phase 2 - 3 Independent Agents)
# Agent 1: Change Analyzer
AGENT_CHANGE_ANALYZER_MODEL=gpt-4o-mini
AGENT_CHANGE_ANALYZER_API_KEY=
AGENT_CHANGE_ANALYZER_BASE_URL=

# Agent 2: Impact Planner
AGENT_IMPACT_PLANNER_MODEL=gpt-4o
AGENT_IMPACT_PLANNER_API_KEY=
AGENT_IMPACT_PLANNER_BASE_URL=

# Agent 3: Doc Generator & Validator
AGENT_DOC_GENERATOR_MODEL=gpt-4o
AGENT_DOC_GENERATOR_API_KEY=
AGENT_DOC_GENERATOR_BASE_URL=
