# Application Environment (development | staging | production | testing)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TracePath AI Backend"
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database (Default SQLite for dev/test, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./tracepath_dev.db
SYNC_DATABASE_URL=sqlite:///./tracepath_dev.db

# Security & Secret Key
SECRET_KEY=tracepath-development-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub App Configuration
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# =========================================================================
# THREE INDEPENDENT AI AGENT CONFIGURATIONS
# =========================================================================

# AGENT 1: Change Analyzer Agent (Semantic Code Extraction & Intent)
AGENT_CHANGE_ANALYZER_MODEL=gemini-2.5-flash
AGENT_CHANGE_ANALYZER_API_KEY=
AGENT_CHANGE_ANALYZER_BASE_URL=
AGENT_CHANGE_ANALYZER_TEMPERATURE=0.1
AGENT_CHANGE_ANALYZER_TIMEOUT=60.0

# AGENT 2: Impact Planner Agent (Documentation Impact & Affected Files Decision)
AGENT_IMPACT_PLANNER_MODEL=gemini-2.5-flash
AGENT_IMPACT_PLANNER_API_KEY=
AGENT_IMPACT_PLANNER_BASE_URL=
AGENT_IMPACT_PLANNER_TEMPERATURE=0.1
AGENT_IMPACT_PLANNER_TIMEOUT=60.0

# AGENT 3: Doc Generator Agent (Minimal Markdown Diff Generation & Assembly)
AGENT_DOC_GENERATOR_MODEL=gemini-2.5-flash
AGENT_DOC_GENERATOR_API_KEY=
AGENT_DOC_GENERATOR_BASE_URL=
AGENT_DOC_GENERATOR_TEMPERATURE=0.2
AGENT_DOC_GENERATOR_TIMEOUT=90.0
