# Application Environment (development | staging | production | testing)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TracePath AI Backend"
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL Database (Default SQLite for dev/test, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./tracepath_dev.db
SYNC_DATABASE_URL=sqlite:///./tracepath_dev.db

# Security & Secret Key
SECRET_KEY=tracepath-development-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub App Configuration
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# =========================================================================
# THREE INDEPENDENT AI AGENT CONFIGURATIONS
# =========================================================================

# AGENT 1: Analysis Agent (Understand What Changed)
AGENT_1_MODEL=gpt-4o-mini
AGENT_1_API_KEY=
AGENT_1_BASE_URL=
AGENT_1_TEMPERATURE=0.1
AGENT_1_TIMEOUT=60.0

# AGENT 2: Differential / Decision Agent (Determine Documentation Impact)
AGENT_2_MODEL=gpt-4o
AGENT_2_API_KEY=
AGENT_2_BASE_URL=
AGENT_2_TEMPERATURE=0.1
AGENT_2_TIMEOUT=60.0

# AGENT 3: Documentation Generator (Generate Minimal Updates & Validate)
AGENT_3_MODEL=gpt-4o
AGENT_3_API_KEY=
AGENT_3_BASE_URL=
AGENT_3_TEMPERATURE=0.2
AGENT_3_TIMEOUT=90.0
